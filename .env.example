# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (database must have the pgvector extension available)
DB_NAME=ecommerce_ai
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# ShopZone seed source (test data)
SHOPZONE_BASE_URL=http://localhost:3000
SHOPZONE_CURRENCY=USD

# Chat model provider: ollama (default) or groq
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:0.5b-instruct
GROQ_API_KEY=
GROQ_MODEL=
